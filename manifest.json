{
  "manifest_version": 3,
  "name": "TimeWarden",
  "version": "3.0",
  "description": "Gestión avanzada de tiempo con IA local, modos y análisis opcional total.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "webNavigation",
    "notifications",
    "idle"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js", "utils.js", "help.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
